# Copy this file to .env and fill in your key from https://developer.clashroyale.com
# The key must allow IP 45.79.218.79 (RoyaleAPI proxy).
CR_API_KEY=your-key-here
CR_API_BASE=https://proxy.royaleapi.dev/v1

# History database (optional). Without it the site works but history tabs stay empty.
#   Any Postgres:            DATABASE_URL=postgres://user:pass@host:5432/db
#   Local, no server needed: DATABASE_URL=pglite:./.data/pg
DATABASE_URL=

# Protects /api/cron/snapshot (send it as "Authorization: Bearer <secret>").
CRON_SECRET=

# Donate button on the error and site-down pages (Ko-fi, Buy Me a Coffee, PayPal.me...).
# Must start with https://. Leave empty to hide the button.
NEXT_PUBLIC_DONATE_URL=

# Maintenance switch: 1 shows the site-down page on every page (rebuild/redeploy to apply).
SITE_DOWN=
