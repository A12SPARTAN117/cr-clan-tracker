# Copy this file to .env and fill in your key from https://developer.clashroyale.com
# The key must allow IP 45.79.218.79 (RoyaleAPI proxy).
CR_API_KEY=your-key-here
CR_API_BASE=https://proxy.royaleapi.dev/v1

# History database (optional). Without it the site works but history tabs stay empty.
#   Any Postgres:            DATABASE_URL=postgres://user:pass@host:5432/db
#   Local, no server needed: DATABASE_URL=pglite:./.data/pg
DATABASE_URL=
# Postgres connections per server process (default 5). Keep instances x this under the pooler's
# client limit: 1-2 on serverless hosts with many instances, 10-20 on one long-running server.
DB_POOL_MAX=

# Protects the /api/cron/* jobs and status (send it as "Authorization: Bearer <secret>").
CRON_SECRET=

# Donate buttons on the support, error and site-down pages: one button per link that's set.
# Each must start with https://. Leave them all empty to hide the buttons.
#   PayPal:  your PayPal.Me link (https://paypal.me/yourname) or a PayPal donate-button link
#   Payfast: a payment link from the Payfast dashboard (SA cards, Instant EFT, wallets)
#   Yoco:    a payment link from the Yoco app or portal (cards, Apple Pay, Google Pay)
#   Other:   Ko-fi, Buy Me a Coffee, GitHub Sponsors...
NEXT_PUBLIC_DONATE_PAYPAL_URL=
NEXT_PUBLIC_DONATE_PAYFAST_URL=
NEXT_PUBLIC_DONATE_YOCO_URL=
NEXT_PUBLIC_DONATE_URL=

# Maintenance switch: 1 shows the site-down page on every page (rebuild/redeploy to apply).
SITE_DOWN=
